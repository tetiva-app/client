		{
			"name": "Pet by id (GraphQL)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query Pet($id: ID!) {\n  pet(id: $id) {\n    id\n    name\n    status\n  }\n}",
						"variables": "{\n  \"id\": \"{{petId}}\"\n}"
					}
				},
				"url": {
					"raw": "{{baseUrl}}/graphql"
				},
				"description": "GraphQL-запрос с переменными."
			},
			"response": [
				{
					"name": "200 OK",
					"originalRequest": {
						"method": "POST",
